      "Faqs": {
        "variants": {
          "GreenHarvestFaqs1": {
            "eyebrow": "FAQs",
            "titlePlain": "Frequently Asked",
            "titleAccent": "Questions",
            "text": "Find quick answers to common questions about our farming solutions and services.",
            "items": [
              {
                "q": "What farming solutions do you offer?",
                "a": "We provide end-to-end farming solutions including crop management, soil health improvement, irrigation support, and expert guidance for better yield and sustainability."
              },
              {
                "q": "Do you support sustainable and eco-friendly farming?",
                "a": "Yes. Sustainability is at the core of everything we do, from organic inputs and water-efficient irrigation to soil-friendly practices that protect the land for the long term."
              },
              {
                "q": "Can small and medium farmers work with you?",
                "a": "Absolutely. Our services are designed to scale, so farms of every size can access expert guidance, quality inputs and modern equipment."
              },
              {
                "q": "Do you offer on-field consultation or training?",
                "a": "Yes. Our agronomists visit your farm for consultations and run regular training programs on modern, sustainable farming techniques."
              },
              {
                "q": "How can I get started with your services?",
                "a": "Simply reach out through the contact form or call us. We will understand your needs and suggest a plan that suits your land and goals."
              },
              {
                "q": "Do you help with crop planning and management?",
                "a": "Yes. We help you plan crop cycles, choose the right varieties and manage inputs through the season for the best possible results."
              },
              {
                "q": "Is there any ongoing support after the service?",
                "a": "Yes. We stay connected after delivery with follow-up visits, seasonal advice and quick support whenever you need it."
              }
            ]
          }
        }
